{
    "name": "sapio-studio",
    "version": "0.2.0-dev",
    "private": true,
    "type": "module",
    "license": "MPL-2.0",
    "description": "A visual workbench for composing and inspecting Sapio contracts",
    "main": "dist/desktop/main.cjs",
    "engines": {
        "node": "^24.0.0 || >=26.0.0"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:web": "vite",
        "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
        "build:desktop": "node scripts/build-desktop.mjs",
        "start": "electron .",
        "typecheck": "tsc --noEmit",
        "test": "npm run build:desktop && vitest run",
        "test:ui": "playwright test",
        "test:sapio": "npm run build:desktop && node --import tsx scripts/check-sapio.ts",
        "format": "prettier --write src desktop shared scripts tests docs *.json *.ts *.md public/demo/*.md",
        "format:check": "prettier --check src desktop shared scripts tests docs *.json *.ts *.md public/demo/*.md"
    },
    "dependencies": {
        "@xyflow/react": "12.11.6",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "lucide-react": "1.46.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@types/node": "24.13.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "electron": "44.3.0",
        "esbuild": "0.28.2",
        "prettier": "3.9.6",
        "tsx": "4.23.13",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.0"
    }
}
